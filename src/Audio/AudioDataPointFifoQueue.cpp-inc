/**
 * @file
 * The <C>AudioDataPointFifoQueue</C> body implements a fifo queue for
 * audio data points with popping off access to the front and appending to
 * the back of the queue <I>(this is the effective code include file
 * for conditional inlining)</I>.
 *
 * @author Dr. Thomas Tensi
 * @date   2022-09
 */

/*=========*/
/* IMPORTS */
/*=========*/

#include "Assertion.h"
#include "Logging.h"
#include "MyArray.h"

/*--------------------*/

using BaseTypes::Containers::copyArray;
using Audio::AudioDataPointFifoQueue;

/*====================*/

INLINE
AudioDataPointFifoQueue::AudioDataPointFifoQueue ()
    : _capacity{0},
      _length{0},
      _firstIndex{0},
      _data{}
{
}

/*--------------------*/

INLINE
AudioDataPointFifoQueue::AudioDataPointFifoQueue (IN Natural capacity)
    : _capacity{capacity},
      _length{0},
      _firstIndex{0},
      _data{}
{
    _data.setLength(capacity);
}

/*--------------------*/

INLINE
AudioDataPointFifoQueue::~AudioDataPointFifoQueue ()
{
    _data.setLength(0);
    _length = 0;
    _capacity = 0;
}

/*--------------------*/

INLINE
String AudioDataPointFifoQueue::toString() const
{
    String st = "[";

    for (Natural i = 0;  i < _length;  i++) {
        st += (i > 0 ? ", " : "") + TOSTRING(_data[i]);
    }

    st += "]";

    String result = "AudioDataPointFifoQueue(";
    result += "_firstIndex = " + TOSTRING(_firstIndex);
    result += ", _length = " + TOSTRING(_length);
    result += ", _capacity = " + TOSTRING(_capacity);
    result += ", _data = " + st;
    result += ")";

    return result;
}

/*--------------------*/

INLINE
void AudioDataPointFifoQueue::ensureCapacity (IN Natural capacity)
{
    if (capacity > _capacity) {
        Natural newCapacity =
            Natural::maximum(capacity, _capacity + _capacity / 10);
        _data.setLength(newCapacity);
        _capacity = newCapacity;
    }
}

/*--------------------*/

INLINE
Natural AudioDataPointFifoQueue::length () const
{
    return _length;
}

/*--------------------*/

INLINE const AudioDataPoint&
AudioDataPointFifoQueue::at (IN Natural position) const
{
    Assertion_pre(position < _length, "position is out of range");
    return _data[_firstIndex + position];
}

/*--------------------*/

INLINE const AudioDataPoint&
AudioDataPointFifoQueue::operator[] (IN Natural position) const
{
    return at(position);
}

/*--------------------*/

INLINE
AudioDataPoint AudioDataPointFifoQueue::pop ()
{
    Assertion_pre(_length > 0, "cannot pop from empty queue");
    AudioDataPoint result = _data.at(_firstIndex++);
    _length--;

    /* when firstIndex exceeds a certain boundary (here 10% of
     * capacity), shift data to the left */
    if (_firstIndex > _capacity / 10) {
        for (Natural i = 0;  i < _length;  i++) {
            _data[i] = _data[_firstIndex + i];
        }

        _firstIndex = 0;
    }
    
    return result;
}

/*--------------------*/

INLINE
void AudioDataPointFifoQueue::pop (INOUT AudioDataPointList& dataPointList,
                                   IN Natural position,
                                   IN Natural count)
{
    const Natural listLength = dataPointList.length();
    Assertion_pre(position + count <= listLength,
                  "count exceeds list length");
    Assertion_pre(count <= length(),
                  "count exceeds queue length");

    Natural j = position;
    
    for (Natural i = 0;  i < count;  i++) {
        dataPointList[j++] = pop();
    }
}

/*--------------------*/

INLINE
void AudioDataPointFifoQueue::append (IN AudioDataPoint& dataPoint)
{
    ensureCapacity(_length + 1);
    _data[_firstIndex + _length] = dataPoint;
    _length++;
}

/*--------------------*/

INLINE
void AudioDataPointFifoQueue::append (IN AudioDataPointList& dataPointList,
                                      IN Natural position,
                                      IN Natural count)
{
    const Natural listLength = dataPointList.length();
    Assertion_pre(position + count <= listLength,
                  "count exceeds list length");

    Natural j = position;
    
    for (Natural i = 0;  i < count;  i++) {
        const AudioDataPoint& dataPoint = dataPointList[j++];
        append(dataPoint);
    }
}

/*--------------------*/

INLINE void
AudioDataPointFifoQueue::toArray (OUT AudioDataPoint* elementArray) const
{
    Logging_trace(">>");

    /* directly access the underlying array */
    const AudioDataPoint* sourcePtr = _data.data();
    copyArray(elementArray, sourcePtr, _length);

    Logging_trace("<<");
}
